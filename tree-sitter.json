{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tree_sitter_modelfile",
      "camelcase": "TreeSitterModelfile",
      "title": "TreeSitterModelfile",
      "scope": "source.tree_sitter_modelfile",
      "file-types": ["tree_sitter_modelfile"],
      "injection-regex": "^tree_sitter_modelfile$",
      "class-name": "TreeSitterTreeSitterModelfile"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Modelfile grammar for tree-sitter",
    "authors": [
      {
        "name": "Jack Smith",
        "email": "jackwsmth@proton.me"
      }
    ],
    "links": {
      "repository": "https://github.com/jackwsmth/tree-sitter-modelfile"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
