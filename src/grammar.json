{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "modelfile",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_instruction"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "_instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "from_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "requires_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "message_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "template_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "system_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "adapter_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "license_instruction"
        }
      ]
    },
    "from_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "FROM"
        },
        {
          "type": "SYMBOL",
          "name": "model_source"
        }
      ]
    },
    "parameter_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "PARAMETER"
        },
        {
          "type": "SYMBOL",
          "name": "parameter"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_value"
        }
      ]
    },
    "requires_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "REQUIRES"
        },
        {
          "type": "SYMBOL",
          "name": "version"
        }
      ]
    },
    "message_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "MESSAGE"
        },
        {
          "type": "SYMBOL",
          "name": "role"
        },
        {
          "type": "SYMBOL",
          "name": "argument"
        }
      ]
    },
    "template_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "TEMPLATE"
        },
        {
          "type": "SYMBOL",
          "name": "multiline_string"
        }
      ]
    },
    "system_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "SYSTEM"
        },
        {
          "type": "SYMBOL",
          "name": "multiline_string"
        }
      ]
    },
    "license_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "LICENSE"
        },
        {
          "type": "SYMBOL",
          "name": "multiline_string"
        }
      ]
    },
    "adapter_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "ADAPTER"
        },
        {
          "type": "SYMBOL",
          "name": "file_path"
        }
      ]
    },
    "model_source": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "model_ref"
        },
        {
          "type": "SYMBOL",
          "name": "model_ref_with_tag"
        },
        {
          "type": "SYMBOL",
          "name": "file_path"
        }
      ]
    },
    "model_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z0-9_.-]+"
      }
    },
    "model_ref_with_tag": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z0-9_.-]+:[a-zA-Z0-9_.-]+"
      }
    },
    "file_path": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "(\\.\\/|\\/)[^\\s]+"
      }
    },
    "version": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\d+\\.\\d+\\.\\d+"
      }
    },
    "parameter": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "num_ctx"
        },
        {
          "type": "STRING",
          "value": "repeat_last_n"
        },
        {
          "type": "STRING",
          "value": "repeat_penalty"
        },
        {
          "type": "STRING",
          "value": "temperature"
        },
        {
          "type": "STRING",
          "value": "seed"
        },
        {
          "type": "STRING",
          "value": "stop"
        },
        {
          "type": "STRING",
          "value": "num_predict"
        },
        {
          "type": "STRING",
          "value": "top_k"
        },
        {
          "type": "STRING",
          "value": "top_p"
        },
        {
          "type": "STRING",
          "value": "min_p"
        }
      ]
    },
    "role": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "system"
        },
        {
          "type": "STRING",
          "value": "user"
        },
        {
          "type": "STRING",
          "value": "assistant"
        }
      ]
    },
    "argument": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s]+"
      }
    },
    "parameter_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_string"
        }
      ]
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "-?\\d+(\\.\\d+)?"
      }
    },
    "quoted_string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\"[^\"]*\""
      }
    },
    "multiline_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\"\"\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "PATTERN",
            "value": ".|\\n"
          }
        },
        {
          "type": "STRING",
          "value": "\"\"\""
        }
      ]
    },
    "_newline": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\n"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[^\\n]*"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}