{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "modelfile",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "instruction"
          },
          {
            "type": "SYMBOL",
            "name": "newline"
          }
        ]
      }
    },
    "instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "from_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "requires_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "message_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "template_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "system_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "adapter_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "license_instruction"
        }
      ]
    },
    "from_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "FROM"
        },
        {
          "type": "SYMBOL",
          "name": "argument"
        }
      ]
    },
    "parameter_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "PARAMETER"
        },
        {
          "type": "SYMBOL",
          "name": "argument"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_value"
        }
      ]
    },
    "requires_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "REQUIRES"
        },
        {
          "type": "SYMBOL",
          "name": "argument"
        }
      ]
    },
    "message_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "MESSAGE"
        },
        {
          "type": "SYMBOL",
          "name": "argument"
        },
        {
          "type": "SYMBOL",
          "name": "argument"
        }
      ]
    },
    "template_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "TEMPLATE"
        },
        {
          "type": "SYMBOL",
          "name": "multiline_string"
        }
      ]
    },
    "system_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "SYSTEM"
        },
        {
          "type": "SYMBOL",
          "name": "multiline_string"
        }
      ]
    },
    "license_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "LICENSE"
        },
        {
          "type": "SYMBOL",
          "name": "multiline_string"
        }
      ]
    },
    "adapter_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "ADAPTER"
        },
        {
          "type": "SYMBOL",
          "name": "argument"
        }
      ]
    },
    "argument": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s]+"
      }
    },
    "parameter_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_string"
        }
      ]
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "-?\\d+(\\.\\d+)?"
      }
    },
    "quoted_string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\"[^\"]*\""
      }
    },
    "multiline_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\"\"\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "PATTERN",
            "value": ".|\\n"
          }
        },
        {
          "type": "STRING",
          "value": "\"\"\""
        }
      ]
    },
    "newline": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\n"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[^\\n]*"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}