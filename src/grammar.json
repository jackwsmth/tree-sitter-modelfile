{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "modelfile",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "instruction"
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    },
    "instruction": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "from_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "parameter_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "requires_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "message_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "template_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "system_instruction"
        },
        {
          "type": "SYMBOL",
          "name": "adapter_instruction"
        }
      ]
    },
    "from_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "FROM"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ".*"
          }
        }
      ]
    },
    "parameter_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "PARAMETER"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ".*"
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ".*"
          }
        }
      ]
    },
    "requires_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "REQUIRES"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ".*"
          }
        }
      ]
    },
    "message_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "MESSAGE"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ".*"
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ".*"
          }
        }
      ]
    },
    "template_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "TEMPLATE"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "\"\"\"([\\s\\S]*?)\"\"\""
          }
        }
      ]
    },
    "system_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "SYSTEM"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "\"\"\"([\\s\\S]*?)\"\"\""
          }
        }
      ]
    },
    "adapter_instruction": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "ADAPTER"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": ".*"
          }
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[^\\n]*"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}